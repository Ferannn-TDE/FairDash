# ─────────────────────────────────────────────────────────────────────────────
# FairSynq — Environment Variables Reference
#
# VERCEL (Frontend + Next.js API routes):
#   Copy the FRONTEND (VERCEL) section into Vercel Dashboard → Settings → Environment Variables
#
# RENDER (Webhook server + BullMQ worker):
#   Copy the BACKEND (RENDER) section into Render Dashboard → Environment Variables
#
# LOCAL DEVELOPMENT:
#   Copy this file to .env.local and fill in all values.
#   .env.local is loaded automatically by Next.js and by dotenv in server.ts.
#   Never commit .env.local to git.
# ─────────────────────────────────────────────────────────────────────────────


# ═══════════════════════════════════════════════════════════════════════════════
# FRONTEND (VERCEL) — Next.js app + serverless API routes
# ═══════════════════════════════════════════════════════════════════════════════

# URL of the Vercel deployment itself (used by the frontend for absolute links)
NEXT_PUBLIC_APP_URL=https://fair-synq.vercel.app

# Render backend URL — used to display webhook endpoint in docs; not used by
# frontend code directly (API calls use Next.js serverless functions on Vercel)
NEXT_PUBLIC_API_URL=https://fairsynq-api.onrender.com

# Clerk — get from Clerk Dashboard → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...   # Clerk Dashboard → Webhooks → signing secret

# Stripe — get from Stripe Dashboard → Developers → API keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...  # Stripe Dashboard → Webhooks → signing secret

# Google Maps — get from Google Cloud Console → APIs → Maps JavaScript API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSy...

# Firebase — get from Firebase Console → Project Settings → Service Accounts
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com

# Firebase Admin — server-side (also needed by Next.js API routes on Vercel)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"

# Supabase PostgreSQL — get from Supabase Dashboard → Settings → Database
# Transaction pooler (port 6543) — for serverless functions on Vercel
DATABASE_URL=postgresql://postgres.YOURREF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct connection (port 5432) — for Prisma migrations and the Render server
DIRECT_URL=postgresql://postgres.YOURREF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Redis — get from Upstash Console (recommended) or your Redis provider
REDIS_URL=rediss://default:PASSWORD@your-instance.upstash.io:6379


# ═══════════════════════════════════════════════════════════════════════════════
# BACKEND (RENDER) — Express webhook server + BullMQ worker
# ═══════════════════════════════════════════════════════════════════════════════

# CORS — allow requests from the Vercel frontend
FRONTEND_URL=https://fair-synq.vercel.app

# Database — use the DIRECT connection (not pgbouncer) for persistent processes
# Same DATABASE_URL and DIRECT_URL as above; Render env vars are set separately.

# All CLERK_*, STRIPE_*, FIREBASE_*, REDIS_URL vars listed above are also
# required on Render — configure them in the Render dashboard individually.
