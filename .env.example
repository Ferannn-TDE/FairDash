# ─────────────────────────────────────────────────────────────────────────────
# FairSynq — Environment Variables Reference
#
# VERCEL (Frontend + Next.js API routes):
#   Copy the FRONTEND (VERCEL) section into Vercel Dashboard → Settings → Environment Variables
#
# RAILWAY (BullMQ worker — `npm run worker`):
#   Copy the WORKER (RAILWAY) section plus the shared vars it lists into Railway → Variables
#
# LOCAL DEVELOPMENT:
#   Copy this file to .env.local and fill in all values.
#   .env.local is loaded automatically by Next.js. Never commit .env.local to git.
# ─────────────────────────────────────────────────────────────────────────────


# ═══════════════════════════════════════════════════════════════════════════════
# FRONTEND (VERCEL) — Next.js app + serverless API routes
# ═══════════════════════════════════════════════════════════════════════════════

# Canonical public URL (no trailing slash). Read by lib/app-url.ts to build the Stripe
# Connect onboarding return links. fairsynq.com and fair-synq.vercel.app both 308 here.
NEXT_PUBLIC_APP_URL=https://www.fairsynq.com

# Clerk — get from Clerk Dashboard → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...   # Clerk webhook → https://www.fairsynq.com/api/webhooks/clerk

# Stripe — get from Stripe Dashboard → Developers → API keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...  # platform endpoint → https://www.fairsynq.com/api/webhooks/stripe
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...  # Connect (v2 thin) destination → https://www.fairsynq.com/api/stripe/connect-webhook

# Google Maps — get from Google Cloud Console → APIs → Maps JavaScript API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSy...

# Firebase — get from Firebase Console → Project Settings → Service Accounts
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com

# Firebase Admin — server-side (also needed by Next.js API routes on Vercel)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"

# Supabase PostgreSQL — get from Supabase Dashboard → Settings → Database
# Transaction pooler (port 6543) — for serverless functions on Vercel
DATABASE_URL=postgresql://postgres.YOURREF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# Direct connection (port 5432) — for Prisma migrations and the Railway worker
DIRECT_URL=postgresql://postgres.YOURREF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Redis — get from Upstash Console (recommended) or your Redis provider
REDIS_URL=rediss://default:PASSWORD@your-instance.upstash.io:6379

# Upstash Redis REST (required for rate limiting — get from Upstash Console)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Upstash Redis — test DB (separate instance, used only by scripts/test-*.ts)
TEST_REDIS_URL=
TEST_REDIS_TOKEN=


# Health check — seconds before /api/health calls the worker stale. Must exceed the
# worker's sweep interval; production runs a 120s timer sweep, so 360.
HEALTH_WORKER_STALE_SEC=360

# Optional — Slack incoming webhook for the admin queue-depth alert (lib/notify.ts).
# Unset = no Slack alerts.
SLACK_WEBHOOK_URL=


# ═══════════════════════════════════════════════════════════════════════════════
# WORKER (RAILWAY) — BullMQ worker + reconciler sweep, start command `npm run worker`
# ═══════════════════════════════════════════════════════════════════════════════

# Shared with Vercel (same values): DATABASE_URL, DIRECT_URL, REDIS_URL, STRIPE_SECRET_KEY,
# FIREBASE_*, NEXT_PUBLIC_FIREBASE_DATABASE_URL, FIREBASE_ENABLED.

# Redis polling throttle (lib/worker-config.ts). Unset = the pre-throttle defaults.
# Production values, sized for the Upstash free tier:
WORKER_SWEEP_SCHEDULER=timer
WORKER_SWEEP_INTERVAL_MS=120000
WORKER_DRAIN_DELAY_SEC=60
WORKER_STALLED_INTERVAL_MS=300000
WORKER_LOCK_DURATION_MS=30000
WORKER_PATTERN_X_INTERVAL_MS=3600000

# Firebase realtime writes — set to 'true' in environments where Firebase is configured
FIREBASE_ENABLED=true
