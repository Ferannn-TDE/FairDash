generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// MULTI-TENANCY: Events are the top-level tenant
// ============================================================================

model Event {
  id   String @id @default(cuid())
  name String

  urlSlug String      @unique // e.g., "springfield-fair-2026"
  status  EventStatus @default(UPCOMING) // Replaces isActive Boolean

  // Dates
  startDate DateTime
  endDate   DateTime

  // Branding (white-label)
  logoUrl      String?
  primaryColor String  @default("#FF0077")
  qrCodeUrl    String?

  // Discovery coords (customer-facing map pin — distinct from staging zone)
  eventLat Float?
  eventLng Float?

  // GPS boundaries + staging zone (stored as JSON)
  gpsBoundaries  Json?
  stagingZoneLat Float?
  stagingZoneLng Float?

  // Multi-fair metadata
  description String?
  timezone    String  @default("America/Chicago")

  // Venue + fair details captured by the organizer create-fair wizard.
  venueAddress  String?
  venueCity     String?
  venueState    String?
  venueZip      String?
  openTime      String? // fair daily open  "HH:MM"
  closeTime     String? // fair daily close "HH:MM"
  maxVendors    Int? // cap on vendors at this fair (distinct from maxVendorsPerOrder cart cap)
  admissionFree Boolean @default(true)

  // Platform controls
  isPaused Boolean @default(false) // one-button platform pause — blocks new orders

  // Operational timing
  orderAcceptanceWindowSec Int @default(120) // how long vendor has to accept before auto-cancel
  vendorOfflineHideSec     Int @default(300) // hide vendor from menu after this many seconds offline
  maxVendorsPerOrder       Int @default(5) // cart cap

  // Customer-facing content
  welcomeMessage      String? // shown on fair home page, max 120 chars
  showVendorWaitTimes Boolean @default(true)
  allowGuestBrowse    Boolean @default(true) // browse menu without logging in

  // Featured vendors section
  featuredVendorIds String[] @default([])
  featuredLabel     String? // e.g. "Featured Today", "Staff Picks"
  featuredEnabled   Boolean  @default(true)

  // Operator service charge (goes 100% to operator, not FairSynq)
  serviceChargeEnabled    Boolean @default(false)
  serviceChargeAmount     Float? // e.g., 1.50 per order
  operatorStripeAccountId String? // destination for service charge + delivery fee transfers

  // Organizer
  organizerId String?
  organizer   FairOrganizer? @relation(fields: [organizerId], references: [id])

  // Soft-delete. null = live; a set timestamp hides the fair from ALL customer +
  // organizer views while preserving the row and every attached financial record
  // (orders, payouts, vendors). Money/audit/integrity paths deliberately ignore
  // this flag so a deleted fair keeps settling.
  archivedAt DateTime?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  vendors           Vendor[]
  orders            Order[]
  adminUsers        AdminUser[]
  fulfillmentConfig FulfillmentConfig?
  runners           Runner[]
  postEventReport   PostEventReport?
  organizerPayouts  OrganizerPayout[]

  @@index([urlSlug])
  @@index([status])
  @@index([status, archivedAt])
}

enum EventStatus {
  ACTIVE // Event is live and accepting orders
  UPCOMING // Event is scheduled but not yet open
  INACTIVE // Event has ended or been deactivated

  // A half-built fair from the create wizard's "Save Draft". A REAL row (same NOT NULL
  // name/startDate/endDate as any fair — there are no partial Events), but excluded from every
  // user-facing, money, analytics and count surface until the wizard publishes it as UPCOMING.
  //
  // ⚠️ EXCLUSION IS NOT PER-QUERY. Organizer list reads go through organizerFairScope()
  // (lib/organizer-fair-context.ts) — one fragment, and adding `status: { not: DRAFT }` inline to a
  // new reader instead is the bug that fragment exists to prevent. Public/customer surfaces already
  // filter `status: ACTIVE` and are covered for free.
  //
  // APPENDED, NOT INSERTED, deliberately: Postgres ALTER TYPE ... ADD VALUE appends, so this is a
  // zero-risk additive migration. It does mean DRAFT sorts LAST under `orderBy: { status: 'asc' }`
  // (the admin fair list) rather than first.
  //
  // Discard is a HARD DELETE, which is only safe because a draft can never acquire a Vendor or
  // Runner (both CASCADE) — enforced at the two attach paths, see assertFairAcceptsJoins().
  DRAFT
}

// ============================================================================
// FULFILLMENT CONFIGURATION (1-1 with Event)
// Centralises all per-event fulfillment mode toggles + related config.
// ============================================================================

model FulfillmentConfig {
  id      String @id @default(cuid())
  eventId String @unique
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // ── Enabled modes ──────────────────────────────────────────────────────────
  boothPickupEnabled  Boolean @default(true)
  curbsideEnabled     Boolean @default(false)
  homeDeliveryEnabled Boolean @default(false)

  // ── Curbside config ────────────────────────────────────────────────────────
  curbsideZoneLat         Float?
  curbsideZoneLng         Float?
  curbsideZoneDescription String? // e.g. "North parking lot, Row A"
  curbsideMethod          CurbsideMethod?
  curbsideFee             Float           @default(0) // Flat fee for curbside (default $0, optional). Same runner/organizer split as delivery.

  // ── Home delivery config ───────────────────────────────────────────────────
  homeDeliveryFee Float? // Flat fee charged to customer

  // ── Fee split ──────────────────────────────────────────────────────────────
  // What % of the applicable runner-fulfilled fee (delivery or curbside) goes to
  // the RUNNER (0–100). The leftover (100 − this) is the ORGANIZER's earning.
  runnerFeePercent           Int     @default(0)
  // Activation acknowledgment: enabling a runner-fulfilled mode (home delivery, or
  // runner-delivers curbside) with runnerFeePercent = 0 means runners earn TIPS ONLY —
  // a legitimate but unusual choice (volunteer/church-fair runners). The admin must set
  // this true to confirm 0-by-intent; the config write refuses 0-by-absence otherwise.
  // See lib/runner-fee-gate.ts.
  runnerTipsOnlyAck          Boolean @default(false)
  homeDeliveryRadiusKm       Float? // Max delivery radius from event coords
  runnerTransportDescription String? // e.g. "Delivered by golf cart"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
}

enum CurbsideMethod {
  RUNNER_DELIVERS // Runner brings the order to the customer's vehicle
  CUSTOMER_WALKS // Customer walks to a designated handoff zone
}

// ============================================================================
// USERS: Synced from Clerk
// ============================================================================

model User {
  id      String  @id @default(cuid())
  clerkId String  @unique // Matches Clerk user ID
  email   String  @unique
  name    String?
  phone   String?

  fcmToken String? // Firebase Cloud Messaging push token

  // Customer notification preferences
  notifOrderUpdates      Boolean @default(true)
  notifSmsAlerts         Boolean @default(true)
  notifPromotionalEmails Boolean @default(false)
  notifNewVendors        Boolean @default(false)

  // Customer profile
  defaultDeliveryAddress String?

  // Vendor/organizer notification preferences (synced across devices)
  notifNewOrder      Boolean @default(true)
  notifVendorOffline Boolean @default(true)
  notifMenuRequests  Boolean @default(true)
  notifDailySummary  Boolean @default(false)

  role         String    @default("customer") // customer | vendor | organizer | runner
  avatarUrl    String?
  isActive     Boolean   @default(true)
  lastSignInAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  orders             Order[]
  vendorMembers      VendorMember[]
  adminUsers         AdminUser[]
  runner             Runner?
  runnerApplications RunnerApplication[]
  orgMembers         OrgMember[]
  favoriteItems      FavoriteItem[]
  vendorAuditLogs    VendorAuditLog[]

  @@index([clerkId])
  @@index([email])
}

// ============================================================================
// VENDORS
// ============================================================================

model Vendor {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Basic info
  name        String
  // Slug is set on creation and intentionally NOT regenerated on rename — changing
  // it would break existing organizer/customer URLs. Scoped unique per event below.
  slug        String
  description String?
  cuisineType String
  boothNumber String?

  // Vendor type
  vendorType VendorType @default(OPTION_A)

  // Status
  status          VendorStatus @default(PENDING)
  isBusy          Boolean      @default(false)
  busyUntil       DateTime? // Auto-clears after 15 min
  isOffline       Boolean      @default(false) // Vendor entirely offline
  lastHeartbeatAt DateTime? // Updated every 30s by vendor dashboard; stale > 5 min → auto-hide

  // ── Onboarding documents (SENSITIVE — insurance certificate, business licence) ──
  // Stores the STORAGE OBJECT PATH inside the PRIVATE `vendor-documents` bucket —
  // deliberately NOT a URL, and deliberately no longer named *Url.
  //
  // These were previously `*Url` columns holding `…/object/public/…` links in a PUBLIC
  // bucket, AND the public customer endpoint returned them verbatim — so a stranger was
  // handed direct links to a vendor's liability insurance and business licence. Renaming
  // the columns to *Path is the STRUCTURAL half of the fix: a public URL can no longer be
  // persisted here without someone noticing they are putting a URL in a Path column.
  // (Same design as Runner.licensePath — see its note below.)
  //
  // Reads are brokered: GET /api/vendors/[id]/documents (vendor-self) and
  // /api/organizer/vendors/[id]/documents (owning organizer / platform admin) mint
  // SHORT-LIVED SIGNED URLs. Nothing renders these paths directly.
  foodHandlerPermitPath String?
  insurancePath         String?
  businessLicensePath   String?
  insuranceExpiryDate   DateTime?
  insuranceExpired      Boolean   @default(false)

  // Operating hours — JSON: Record<Day, { open: string; close: string; enabled: boolean }>
  operatingHours Json?

  // Vendor-operator notification preferences — JSON:
  // { newOrder: bool, orderReady: bool, dailySummary: bool, marketing: bool }
  notificationPrefs Json?

  // Booth photos (array of URLs)
  boothPhotoUrls Json?

  // Application contact — the vendor's contact for THIS application. Kept on
  // Vendor (not duplicated onto User) because it may differ from the applicant's
  // Clerk identity; the User row stays the single source of truth for their login.
  contactName  String?
  contactEmail String?
  contactPhone String?

  // Legal consent — an AUDITABLE record, not a bare boolean: who signed, which
  // terms version, when (server time), and from where (request IP). Set on
  // application submit. Makes the agreement step's "Session IP logged" claim real.
  termsAcceptedName String?
  termsVersion      String?
  termsAcceptedAt   DateTime?
  termsAcceptedIp   String?

  // Stripe Connect
  stripeAccountId   String?
  stripeVerified    Boolean   @default(false)
  stripeConnectedAt DateTime?

  // ── Admin payout freeze (C1) ────────────────────────────────────────────────
  // The kill-switch pattern (mirrors FairOrganizer.suspendedAt): admin-only write,
  // immediate DB-state effect, no self-rescue. Set → the payout executor holds
  // EVERY payout for this vendor, on every order, until an admin clears it. This is
  // the blunt "freeze a bad actor" lever; the surgical per-order lever is
  // VendorEarning.status='held'. Both are checked in the SAME executor gate.
  payoutsFrozenAt     DateTime?
  payoutsFrozenReason String?
  payoutsFrozenBy     String? // admin Clerk id (the AdminMoneyAction row has the full audit)

  // Commission
  commissionRate Float @default(0.10) // DEPRECATED — abandoned vendor-commission model; not read anywhere. Drop in a future migration.

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  menuItems           MenuItem[]
  orders              Order[]
  orderItems          OrderItem[]
  vendorOrderStatuses VendorOrderStatus[]
  vendorMembers       VendorMember[]
  cancellations       Cancellation[]
  payouts             Payout[]
  notifications       VendorNotification[]
  disputes            Dispute[]
  menuRequests        MenuRequest[]
  auditLogs           VendorAuditLog[]
  payoutHolds         PayoutHold[]
  refunds             Refund[]
  refundRequests      RefundRequest[]
  vendorEarnings      VendorEarning[]

  @@unique([eventId, slug], map: "uq_vendor_event_slug")
  @@index([eventId, status], map: "idx_vendor_event_status")
  @@index([eventId, isOffline], map: "idx_vendor_event_active")
  @@index([status])
  @@index([stripeVerified])
  @@index([isOffline])
}

enum VendorType {
  OPTION_A // Self-service (Stripe Connect, own device)
  OPTION_B // FairSynq managed (Square Terminal, settled at event end)
}

enum VendorStatus {
  PENDING // Application submitted, awaiting approval
  ACTIVE // Approved and live
  PAUSED // Temporarily paused by operator
  SUSPENDED // Suspended by admin
  REJECTED // Application declined
}

model VendorMember {
  id       String @id @default(cuid())
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String @default("staff") // owner | manager | staff

  // ── OPERATOR ADMITTANCE ─────────────────────────────────────────────────────
  //
  // ⚠️ READ THIS BEFORE TOUCHING EITHER FIELD. There are TWO "status" concepts on the
  // vendor side, they sit two models apart, and the whole design depends on never
  // confusing them:
  //
  //   VendorMember.approvalStatus (HERE) = "may this HUMAN operate this booth"
  //   Vendor.status               (:232) = "may this BOOTH trade"
  //
  // They are INDEPENDENT axes and neither implies the other. An APPROVED operator whose
  // booth is PENDING still cannot take orders (app/api/orders/route.ts gates on
  // Vendor.status). A REJECTED operator whose booth is ACTIVE must not be able to work it
  // — which is the hole this axis exists to close. Booth trading, readiness
  // (lib/vendor-readiness.ts) and payouts read Vendor.status and are NOT affected by the
  // field below; do not wire them to it.
  //
  // Reuses the SHARED ApprovalStatus enum (see its definition below) and the same
  // four-field audit shape as Runner (:1142) and FairOrganizer (:1071) — one lifecycle,
  // three subjects. approvedBy holds an admin User.id, resolved from the acting admin's
  // Clerk id, because User.id is the only identity this DB can JOIN on ("who admitted
  // this operator" should be answerable in SQL, not via a Clerk round-trip). It is
  // deliberately a plain String? and NOT a relation: the 'system-grandfather' sentinel
  // written by the backfill migration is not a User.id, and an FK would reject it —
  // matching :1073 and :1144.
  //
  // Rejection is REVERSIBLE here (organizer's model, not runner's terminal one): an
  // admin may re-admit a REJECTED operator, which clears rejectionReason.
  //
  // 🔌 INERT AS OF THIS MIGRATION. Nothing reads approvalStatus yet — no gate, no route,
  // no UI. Enforcement lands in later, separate commits (portal door + gate screen, then
  // the accept-verb re-verification). The backfill ships FIRST and ALONE, deliberately, so
  // the grandfather is in the database before anything can lock anyone out.
  approvalStatus  ApprovalStatus @default(PENDING)
  approvedAt      DateTime?
  approvedBy      String? // admin User.id, or the 'system-grandfather' backfill sentinel
  rejectionReason String?

  createdAt DateTime @default(now())

  @@unique([vendorId, userId])
  @@unique([userId, vendorId], map: "uq_vendormember_user_vendor")
  @@index([approvalStatus])
}

// ============================================================================
// MENU ITEMS
// ============================================================================

model MenuItem {
  id       String @id @default(cuid())
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  name        String
  description String?
  price       Float
  category    String
  imageUrl    String?
  prepTime    Int     @default(15) // Minutes to prepare — used for estimated ready time

  // Variant grouping — set by vendor when the same dish comes in multiple sizes.
  // Items sharing the same variantGroup (within a vendor) collapse into one card.
  variantGroup String? // e.g. "Bagna Cauda"  — null means standalone item
  variantLabel String? // e.g. "Small", "Medium" — null means standalone item

  isAvailable Boolean @default(true) // Sold-out toggle

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  orderItems    OrderItem[]
  favoriteItems FavoriteItem[]
  menuRequests  MenuRequest[]

  @@index([vendorId])
  @@index([isAvailable])
}

// ============================================================================
// MENU CHANGE REQUESTS (ADD / EDIT / DELETE require organizer approval)
// ============================================================================

model MenuRequest {
  id          String @id @default(cuid())
  vendorId    String
  vendor      Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  requestedBy String // userId

  type   MenuRequestType
  status MenuRequestStatus @default(PENDING)

  // Proposed item fields (used for ADD and EDIT)
  name        String?
  description String?
  price       Float?
  category    String?
  prepTime    Int?
  imageUrl    String?

  // For EDIT and DELETE — the existing item being modified
  menuItemId String?
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  // Review
  reviewedBy String?
  reviewedAt DateTime?
  reviewNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId])
  @@index([status])
}

enum MenuRequestType {
  ADD
  EDIT
  DELETE
}

enum MenuRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// ============================================================================
// ORDERS
// ============================================================================

model Order {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  customerId String
  customer   User   @relation(fields: [customerId], references: [id])

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  // Status
  status OrderStatus @default(PLACED)

  // Fulfillment
  fulfillmentType FulfillmentType @default(BOOTH_PICKUP)

  // Pricing (all in USD)
  subtotal     Float // Sum of item prices × quantities
  deliveryFee  Float? // The applicable runner-fulfilled fee (home delivery OR curbside); split runner/organizer. Null/0 for booth pickup.
  tip          Float? // Customer tip on runner-fulfilled orders only. 100% the runner's; NO service fee, NO split. Null/0 otherwise.
  total        Float // subtotal + serviceFee(10%×subtotal) + deliveryFee + serviceCharge + tip
  fairSynqFee  Float // FairSynq revenue = 10% service fee charged to the customer on top (on subtotal only)
  vendorPayout Float // = subtotal in full — vendor keeps everything, no commission deducted

  // Customer info
  customerName   String
  customerPhone  String
  pickupLocation String? // Booth number or staging zone (BOOTH_PICKUP / CURBSIDE)

  // ── Curbside fields ────────────────────────────────────────────────────────
  vehicleMake  String? // e.g. "Toyota"
  vehicleColor String? // e.g. "Silver"
  vehiclePlate String? // e.g. "ABC 1234"

  // ── Home delivery address ──────────────────────────────────────────────────
  // Validated and rendered through lib/delivery-address.ts — the one definition of a
  // deliverable address (required: street/city/zip) and the one formatter. Nothing on the
  // write path may invent a value to satisfy a validator: a missing field stays NULL.
  deliveryStreet String?
  deliveryUnit   String? // apartment / suite / room — Places never supplies it; a dorm needs it
  deliveryCity   String?
  deliveryState  String? // 2-letter code, from administrative_area_level_1 when autocomplete fires
  deliveryZip    String?

  // Operator service charge collected at checkout (goes to event operator, not FairSynq)
  serviceCharge Float?

  // Cancellation fee ($5 if customer cancels after vendor accepts)
  cancellationFee Float?

  // Runner dispatch
  runnerId     String?
  dispatchedAt DateTime?

  // ── Delivery custody (Commit 2 — possession-split escape path) ───────────────
  // The custody lifecycle is keyed on these COLUMNS, not on master status: claim ==
  // RUNNER_COLLECTED today, and a real "collect from vendor" action sets collectedAt.
  // The split:
  //   collectedAt NULL → runner claimed, but the food is still on the vendor's counter
  //   collectedAt SET  → the runner physically has the bag
  // A collected order is REVERSIBLE (runner returns it, vendor confirms) — which is
  // precisely why the vendor-VOS advance stays on DELIVERED (the earliest IRREVERSIBLE
  // vendor-done signal) and is NOT moved onto collectedAt. INVARIANT: VOS advances ride
  // irreversible events only; moving one onto a human-tappable/reversible event forces a
  // non-monotonic revert, the oscillation the clamp model exists to forbid.
  collectedAt       DateTime? // the "collect from vendor" server action fired (U1)
  releasedAt        DateTime? // returned to the pool (U2); the runner feed re-arms off THIS, never readyAt
  returnRequestedAt DateTime? // post-collection (U3): runner asked to hand the bag back, awaiting vendor confirm

  // Strand clocks RAISE A FLAG — a human decides; nothing here ever auto-acts. strandedReason
  // names the action a human must take (see enum StrandedReason). A strand is CLEARED (both
  // fields → null + a `strand_cleared` custody event) when resolved by a legitimate action,
  // so the ALERTS line never accretes wallpaper (the Pattern-K lesson).
  strandedAt     DateTime?
  strandedReason StrandedReason?

  // Proof-of-delivery photo — mandatory before DELIVERED for runner-fulfilled orders
  // (HOME_DELIVERY *and* CURBSIDE). Holds the Supabase Storage object PATH (in the private
  // `delivery-proofs` bucket), NOT a URL and NEVER a signed URL — a stored signed URL is
  // true when written and lies later. Resolve to a signed READ url at read time.
  //
  // ⚠️ CHARGEBACK EVIDENCE. This photo is the proof that answers a card dispute, which per
  // the fee-model can arrive ~120 days after the fair. Any future read path for it is on the
  // MONEY/AUDIT path and MUST resolve the order with includeArchived (INCLUDE archived fairs,
  // not EXCLUDE) — the 13-INCLUDE soft-delete floor. If a read scopes through a fair lookup
  // with archivedAt: null, the proof becomes unreadable EXACTLY when it's needed: fair
  // archived, chargeback open, money at stake. INCLUDE, not EXCLUDE.
  deliveryProofPath String?

  // Home delivery — GPS confirmation (must be within 100m of address)
  runnerConfirmedLat Float?
  runnerConfirmedLng Float?

  // Claim-time VEHICLE SNAPSHOT — the car that actually took THIS order, captured when the
  // runner claims (the profile is mutable; the event is forever). Current-state for the
  // customer's driver card; cleared on release/return-confirm so a re-claimer re-snapshots.
  // The append-only record of runner A's vehicle lives in the 'claimed' DeliveryCustodyEvent
  // metadata (written in the SAME claim transaction), so clearing these never loses history.
  runnerVehicleMake  String?
  runnerVehicleColor String?
  runnerVehiclePlate String?

  // Estimated ready time (placedAt + max(item.prepTime) across order items)
  estimatedReadyAt DateTime?

  // Stripe (per-transaction)
  stripePaymentIntentId String?
  stripeChargeId        String?
  stripeTransferId      String? // Transfer to vendor Stripe account

  // Timestamps
  placedAt    DateTime  @default(now())
  acceptedAt  DateTime?
  startedAt   DateTime? // When vendor taps Accept — triggers $5 cancellation fee window
  readyAt     DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  // Cancellation metadata
  cancelledBy        String? // "vendor" | "customer" | "system"
  cancellationReason String?

  // Uncollected (timeout after READY)
  uncollectedAt DateTime?

  // Async payout status (set by process-vendor-payout worker)
  payoutStatus PayoutStatus?

  // Part B B4 — tip-refund record (1:1 with the order, so the order row carries it,
  // ledger-as-record like the runner case). Set when a CANCELLED runner-fulfilled
  // order's tip is owed BACK to the customer (no runner ever earned it). Presence =
  // refunded; the idempotency key tip_refund_${id} + this field prevent double-refund.
  tipRefundId   String?   @unique
  tipRefundedAt DateTime?

  // Out-of-model exclusion marker. NOT a terminal status (these orders may be
  // COMPLETED/CANCELLED/PLACED in their own right) — a distinct flag meaning
  // "intentionally excluded from reconciliation/payout" (e.g. pre-fee-model test
  // data). The reconciler skips any order with voidedAt set. Stripe is untouched.
  voidedAt   DateTime?
  voidReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  orderItems          OrderItem[]
  vendorOrderStatuses VendorOrderStatus[]
  cancellation        Cancellation?
  orderEvents         OrderEvent[]
  custodyEvents       DeliveryCustodyEvent[]
  incidentReports     IncidentReport[]
  disputes            Dispute[]
  payouts             Payout[]
  payoutHolds         PayoutHold[]
  refunds             Refund[]
  refundRequests      RefundRequest[]
  chargebacks         Chargeback[]
  runnerEarning       RunnerEarning?
  organizerEarning    OrganizerEarning?
  vendorEarnings      VendorEarning[] // N per order (one per payable vendor)

  @@unique([placedAt, id], map: "uq_order_placed_id")
  @@index([customerId, placedAt(sort: Desc)], map: "idx_order_customer_placed")
  @@index([eventId, status], map: "idx_order_event_status")
  @@index([eventId, placedAt(sort: Desc)], map: "idx_order_event_placed")
  @@index([vendorId, placedAt(sort: Desc)], map: "idx_order_vendor_placed")
  @@index([vendorId, status, placedAt(sort: Desc)], map: "idx_order_vendor_status_placed")
  @@index([status])
  @@index([fulfillmentType])
  // The dispute webhook and refund engine resolve orders by Stripe charge id.
  @@index([stripeChargeId], map: "idx_order_stripe_charge")
}

enum OrderStatus {
  PENDING_PAYMENT // Order created, awaiting Stripe payment confirmation
  PLACED // Payment confirmed — awaiting vendor acceptance
  ACCEPTED // Vendor accepted (starts $5 cancellation fee window)
  PREPARING // Vendor is preparing the order
  READY // Ready for pickup / runner dispatched
  RUNNER_COLLECTED // Runner confirmed pickup from vendor booth
  COMPLETED // Collected by customer or delivered by runner
  DELIVERED // Runner confirmed home delivery (GPS-verified)
  CANCELLED // Cancelled by vendor, customer, or system
  UNCOLLECTED // Customer never collected (10-min timeout after READY)
  UNDELIVERABLE // Home delivery address unreachable by runner
}

enum FulfillmentType {
  BOOTH_PICKUP // Customer collects directly at vendor booth
  CURBSIDE // Runner delivers to customer's vehicle in parking zone
  HOME_DELIVERY // Runner delivers to customer's off-site address
}

enum PayoutStatus {
  PENDING // Job enqueued, transfer not yet attempted
  COMPLETED // Stripe transfer succeeded
  FAILED // All retry attempts exhausted — requires manual intervention
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])

  // Denormalized snapshot of the menu item name at order time.
  // Eliminates the menuItem join on every dashboard query.
  itemName String @default("")

  quantity            Int
  unitPrice           Float
  totalPrice          Float // unitPrice * quantity, stored at creation time
  subtotal            Float
  specialInstructions String?

  createdAt DateTime @default(now())

  @@index([vendorId, orderId], map: "idx_orderitem_vendor_order")
  @@index([menuItemId], map: "idx_orderitem_menuitem")
  @@index([orderId])
  @@index([vendorId, createdAt], map: "idx_orderitem_vendor_created")
  @@index([vendorId, menuItemId, createdAt], map: "idx_orderitem_vendor_menu_created")
}

// ============================================================================
// PER-VENDOR ORDER STATUS
// Tracks each vendor's independent acceptance/fulfilment state within a
// multi-vendor order. The master Order.status reflects the aggregate state.
// ============================================================================

model VendorOrderStatus {
  id       String @id @default(cuid())
  orderId  String
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  // PLACED → ACCEPTED → PREPARING → READY → COMPLETED
  // or      PLACED → DECLINED
  status  String @default("PLACED")
  version Int    @default(1)

  acceptedAt  DateTime?
  preparingAt DateTime?
  readyAt     DateTime?
  completedAt DateTime?
  declinedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, vendorId])
  @@index([status], map: "idx_vos_status")
  @@index([vendorId, status], map: "idx_vos_vendor_status")
}

// ============================================================================
// CANCELLATIONS
// ============================================================================

model Cancellation {
  id      String @id @default(cuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  reason       String?
  cancelledAt  DateTime @default(now())
  // DEPRECATED — no longer written (Cancellation is now a pure audit row: who/when/
  // why). Refund money-truth lives in the Refund rows; all readers derive from
  // Σ Refund.amountCents (status=COMPLETED). These columns drifted on ~80% of
  // historical rows (four writers, four meanings). Kept nullable as dead history;
  // drop in a later sweep once a deploy cycle confirms nothing reads them.
  refundIssued Boolean  @default(false)
  refundAmount Float?

  @@index([vendorId])
}

// ============================================================================
// PAYOUTS: Per-transaction Stripe transfers
// ============================================================================

model Payout {
  id      String @id @default(cuid())
  eventId String

  // The order this payout settles. Required for completed-vs-paid reconciliation.
  // Nullable only to tolerate legacy rows (there are none); always set by code.
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  // Amounts (USD) — per vendor, per order
  grossAmount Float // This vendor's subtotal slice
  fairSynqFee Float // Stripe processing-fee share withheld from this transfer (NOT FairSynq's 10%)
  netAmount   Float // grossAmount - fairSynqFee = amount actually transferred to the vendor

  // Stripe transfer record
  stripeTransferId String @unique
  stripeStatus     String // pending | paid | failed

  // Reversal convergence (CASE 2 refund-after-payout). When a transfer is
  // reversed to claw back a refunded slice, the refund engine sets these. They
  // are the AUTHORITATIVE post-reversal truth: any reader (reconciler, earnings)
  // must treat reversedAt != null as "this payout was clawed back", regardless
  // of stripeStatus — because the transfer.paid webhook may still set
  // stripeStatus='paid' after the reversal. Neither write path (webhook upsert
  // create-only, worker upsert) touches these fields, so they never go stale.
  reversedAt       DateTime?
  stripeReversalId String?

  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([orderId, vendorId], map: "uq_payout_order_vendor")
  @@index([vendorId])
  @@index([eventId])
  @@index([orderId])
}

// ============================================================================
// PAYOUT HOLDS
// A vendor's payout slice that could NOT be transferred at completion time —
// almost always because the vendor isn't Stripe-connected/verified yet. Persisted
// (not just logged) so the reconciler can pay it once the vendor connects.
// ============================================================================

model PayoutHold {
  id      String @id @default(cuid())
  eventId String

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  // What the vendor is owed (their subtotal slice − Stripe fee share), in cents.
  amountCents Int
  reason      String // 'unconnected' | 'non_positive' | other

  resolved   Boolean   @default(false) // true once a transfer for this slice succeeds
  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, vendorId], map: "uq_payouthold_order_vendor")
  @@index([resolved])
  @@index([vendorId, resolved])
}

// ============================================================================
// REFUNDS: per-vendor money-truth (mirrors Payout).
// One row per (order, vendor) refund. The customer is returned this vendor's
// SUBTOTAL SLICE ONLY — the 10% service fee is NEVER refunded (decision B), and
// Stripe's processing fee is NOT recovered (FairSynq eats it). amountCents is
// the slice in integer cents. stripeReversalId is set only in CASE 2 (refund
// after the vendor payout already fired).
// ============================================================================

model Refund {
  id      String @id @default(cuid())
  eventId String

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  amountCents      Int // vendor subtotal slice returned to customer (NEVER the fee)
  reason           String?
  status           String // PENDING | COMPLETED | FAILED
  stripeRefundId   String? // the customer refund on the original charge
  stripeReversalId String? // CASE 2 only — transfer reversal clawing back the vendor

  createdBy String? // actor id (admin/organizer/customer/system)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, vendorId], map: "uq_refund_order_vendor")
  @@index([status])
  @@index([vendorId])
  @@index([orderId])
  @@index([eventId])
}

// ============================================================================
// REFUND REQUESTS: customer-initiated requests for a vendor portion AFTER that
// vendor accepted. Customers cannot self-refund post-acceptance (decision E) —
// they file a request that an admin/organizer approves, which then calls the
// SAME refundVendorPortion() engine. "Customer asked" is kept distinct from
// "money moved" (the Refund row).
// ============================================================================

model RefundRequest {
  id      String @id @default(cuid())
  eventId String

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  reason      String?
  status      String    @default("PENDING") // PENDING | APPROVED | DENIED
  requestedBy String
  resolvedBy  String?
  resolvedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, vendorId], map: "uq_refundrequest_order_vendor")
  @@index([status])
  @@index([eventId, status])
}

// ============================================================================
// NEGATIVE BALANCE EVENTS: FairSynq's clawback-debt ledger.
// When a CASE 2 transfer reversal hits a vendor whose connected balance is
// insufficient, the reversal still completes (losses_collector: 'application')
// — FairSynq fronts the money to keep the customer refunded. This row tracks
// what the vendor owes back. Deliberately relation-free (plain ids) so the debt
// record survives even if the order is later removed. The reconciler surfaces
// unresolved (open) rows so debts are chased, never silently absorbed.
// ============================================================================

model NegativeBalanceEvent {
  id      String @id @default(cuid())
  eventId String

  orderId  String
  vendorId String

  amountCents Int // amount FairSynq fronted that the vendor owes back
  reversalId  String? // the Stripe transfer reversal that went negative
  status      String  @default("open") // open | chased | recovered
  // What created this debt: refund_reversal (CASE 2 refund), dispute_clawback
  // (chargeback reversal that went negative), dispute_fee (~$15 dispute fee
  // FairSynq absorbed but recoverable from the at-fault vendor). One ledger,
  // typed entries — the "what does this vendor owe FairSynq" view.
  kind        String  @default("refund_reversal")
  note        String?

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([status])
  @@index([vendorId, status])
  @@index([eventId])
}

// ============================================================================
// CHARGEBACKS: bank-initiated disputes (charge.dispute.*). Distinct from the
// in-app Dispute model (customer/vendor complaints). A chargeback is money the
// BANK already pulled — we do NOT refund the customer (they were paid by the
// bank); we claw back the vendors' slices proportionally (reuse the CASE 2
// reversal machinery), front any gaps (NegativeBalanceEvent kind=dispute_clawback),
// record the ~$15 fee as recoverable (kind=dispute_fee), and SURFACE to admin.
// The fight/accept decision is human (Stripe dashboard) — never auto.
// ============================================================================

model Chargeback {
  id      String @id @default(cuid())
  eventId String

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  stripeDisputeId String  @unique // idempotency anchor — dispute events redeliver
  stripeChargeId  String
  amountCents     Int // the whole charge the bank pulled
  feeCents        Int // Stripe's dispute fee (~$15), FairSynq-absorbed-but-recoverable
  reason          String? // Stripe dispute reason

  // Mirrors Stripe dispute.status: needs_response | under_review | won | lost | ...
  status          String
  atFaultVendorId String? // admin-set (or inferred); the fee is recoverable from them
  clawbackStatus  String  @default("pending") // pending | done | partial
  fundsReinstated Boolean @default(false) // set on funds_reinstated (WON) — admin reconciles

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([orderId])
  @@index([eventId])
}

// ============================================================================
// ADMIN USERS
// ============================================================================

model AdminUser {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role    AdminRole
  eventId String? // null = super_admin (platform-wide), set = event_operator
  event   Event?    @relation(fields: [eventId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, eventId])
  @@index([userId])
  @@index([role])
}

enum AdminRole {
  SUPER_ADMIN // Full platform access
  EVENT_OPERATOR // Scoped to a single event
}

// ============================================================================
// VENDOR NOTIFICATIONS
// ============================================================================

model VendorNotification {
  id       String @id @default(cuid())
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  type    String // new_order | order_cancelled | payout_sent | system
  message String

  sentAt         DateTime  @default(now())
  acknowledgedAt DateTime?

  @@index([vendorId])
}

// ============================================================================
// FAIR ORGANIZER
// Org-level profile for event operators. One organizer can run multiple fairs.
// ============================================================================

model FairOrganizer {
  id               String  @id @default(cuid())
  name             String
  contactEmail     String
  contactPhone     String?
  website          String?
  stripeCustomerId String? // for 2027 licensing billing

  // Stripe Connect (Part B payout destination). Deliberately at the ORGANIZER
  // level, NOT per-event: one organizer = one connected account, reused across
  // all their fairs (avoids re-onboarding for every event — same lesson as the
  // vendor dedup). An event's payout destination resolves via event.organizer.
  // (Event.operatorStripeAccountId remains an optional per-event override.)
  stripeAccountId   String?
  stripeVerified    Boolean   @default(false)
  stripeConnectedAt DateTime?

  // ── Organizer approval gate (#7) ─────────────────────────────────────────────
  // The organizer is the HIGHEST-authority role (runs whole fairs, approves vendors,
  // sits in the money-control flow) and was the only ungated one — self-active on
  // signup. Now: PENDING until a platform admin approves. Reuses the SAME
  // ApprovalStatus enum + audit-field shape as Runner (the runner migration named the
  // enum generically for exactly this).
  //
  // ENFORCEMENT is one check in requireOrganizerAuth (lib/auth.ts) — every one of the
  // 26 organizer routes funnels through it, so a PENDING organizer is blocked from
  // fair creation, vendor approval, refunds, disputes and chargebacks server-side, not
  // by hiding buttons. /api/organizer/profile deliberately uses plain requireAuth, so a
  // pending organizer can still load an "awaiting approval" shell.
  //
  // Because fair CREATION is gated, a pending organizer can never accumulate a fair —
  // so there is no orphaned-fair problem on rejection (nothing downstream to clean up).
  //
  // PLATFORM-LEVEL, not per-fair: an organizer owns many fairs, so approval means "you
  // may be an organizer at all". Approve/reject ride requireStrictAdminAuth, matching
  // the existing organizer-suspend route — NOT the fair-scoped chokepoint.
  approvalStatus  ApprovalStatus @default(PENDING)
  approvedAt      DateTime?
  approvedBy      String? // admin Clerk id (or 'system-grandfather')
  rejectionReason String?

  // A6 kill-switch — org-wide suspension (D4). When suspendedAt is set, EVERY
  // request through requireOrganizerAuth for a member of this organizer is denied
  // (403 ORGANIZER_SUSPENDED). Deliberately DB state, not Clerk metadata: because
  // requireOrganizerAuth reads fresh per request, suspension takes effect on the
  // NEXT request — no token lag. Set/cleared only via the admin-gated write.
  // DISTINCT from approvalStatus: approval is "may you operate at all"; suspension is
  // "you were approved, but we've stopped you". Both gate, for different reasons.
  suspendedAt     DateTime?
  suspendedReason String?

  // ── Admin payout freeze (C1) ────────────────────────────────────────────────
  // DISTINCT from suspendedAt: suspension blocks the organizer's REQUESTS (portal
  // access); this blocks their MONEY (batch payouts) while leaving the portal
  // usable. An admin investigating a fair may want one without the other.
  payoutsFrozenAt     DateTime?
  payoutsFrozenReason String?
  payoutsFrozenBy     String? // admin Clerk id

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  fairs   Event[]
  members OrgMember[]

  @@index([stripeVerified])
  @@index([stripeAccountId])
  @@index([suspendedAt])
  @@index([approvalStatus])
  @@index([payoutsFrozenAt])
}

model OrgMember {
  id          String        @id @default(cuid())
  organizerId String
  organizer   FairOrganizer @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String        @default("member") // owner | member

  createdAt DateTime @default(now())

  @@unique([organizerId, userId])
  @@index([organizerId])
  @@index([userId])
}

// ============================================================================
// RUNNERS
// Event-staff role — assigned per event, tracked per-event.
// ============================================================================

model Runner {
  id      String @id @default(cuid())
  userId  String @unique
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  status RunnerStatus @default(OFFLINE)

  // ── Admin approval gate ──────────────────────────────────────────────────────
  // A runner cannot go online OR claim a delivery until an admin approves them.
  // New rows default to PENDING; the grandfather migration promoted pre-existing
  // rows to APPROVED so the gate doesn't lock out current runners. These audit
  // fields are the shared shape organizer approval (#7) will mirror.
  approvalStatus  ApprovalStatus @default(PENDING)
  approvedAt      DateTime?
  approvedBy      String? // admin User.id who approved/rejected
  rejectionReason String?

  // ── DEPRECATED, write-dead (2026-07-23) — do NOT wire these back up ─────────
  // No write site has ever existed; they sat at 0 / 0 / 1.0 while real deliveries
  // happened, and fed an admin <90% warning banner that could never fire. The REAL
  // sources: delivery counts + completion rate derive from DeliveryCustodyEvent via
  // lib/runner-completion.ts (custody is the spine for COUNTS); money derives from
  // RunnerEarning via lib/runner-earnings.ts (the ledger is the spine for MONEY).
  // Guarded by scripts/runner-stats-source-guard.ts. Drop migration pending as a
  // separate reviewed change.
  completionRate  Float @default(1.0)
  totalDispatched Int   @default(0)
  totalCompleted  Int   @default(0)

  // Live GPS (written every ~10s during active RUNNER_COLLECTED delivery)
  currentLat        Float?
  currentLng        Float?
  currentAccuracy   Float? // GPS accuracy in meters (Phase 3: stale/precision UX)
  locationUpdatedAt DateTime?

  // Stripe Connect (Part B payout destination — net-new for runners; mirrors
  // Vendor). The unpaid RunnerEarning rows ARE the hold: a runner who delivers
  // before connecting accrues earnings that pay out the moment they verify.
  stripeAccountId   String?
  stripeVerified    Boolean   @default(false)
  stripeConnectedAt DateTime?

  // ── Admin payout freeze (C1) ────────────────────────────────────────────────
  // Same kill-switch shape as Vendor.payoutsFrozenAt. Set → every RunnerEarning for
  // this runner is held by the executor gate, on every order, until an admin clears
  // it. The surgical per-order lever is RunnerEarning.status='held'.
  payoutsFrozenAt     DateTime?
  payoutsFrozenReason String?
  payoutsFrozenBy     String? // admin Clerk id

  // ── Runner-editable settings (persisted from the Settings page; me-scoped) ────
  // Identity name/email remain Clerk-owned (single source of truth); only the
  // runner-specific fields live here.
  phone        String? // delivery-contact phone
  vehicleMake  String?
  vehicleModel String?
  vehicleColor String?
  vehiclePlate String?

  // ── Driver's licence (SENSITIVE PII) ─────────────────────────────────────────
  // Stores the STORAGE OBJECT PATH inside the PRIVATE `runner-documents` bucket —
  // deliberately NOT a URL. The vendor-document pattern persists a public URL
  // (…/object/public/…), which for a driver's licence would publish someone's photo,
  // DOB, and home address to anyone who guesses or leaks the link. Reads here go
  // through /api/runners/me/license (self) or /api/admin/runners/[id]/license (admin),
  // each of which mints a short-lived signed URL. Nothing renders this path directly.
  licensePath       String?
  licenseUploadedAt DateTime?

  // Runner-portal notification preferences
  notifyNewDelivery  Boolean @default(true)
  notifyOrderUpdates Boolean @default(true)
  notifyEarnings     Boolean @default(false)

  // Availability — weekday short-names the runner marks available, e.g. ["Fri","Sat","Sun"]
  availableDays String[] @default([])

  createdAt DateTime @default(now())

  // Relations
  incidentReports IncidentReport[]
  earnings        RunnerEarning[]
  profileChanges  RunnerProfileChange[]

  @@index([eventId])
  @@index([status])
  @@index([stripeVerified])
  @@index([stripeAccountId])
  @@index([approvalStatus])
  @@index([payoutsFrozenAt])
}

// ============================================================================
// RUNNER EARNINGS: per completed delivery, what the runner earned. amountCents =
// the runner's SHARE of the runner-fulfilled fee (runnerFeePercent × fee) + 100%
// of the tip — NOT the whole customer-paid fee (the organizer holds the other
// share as OrganizerEarning). Part B B2 DID wire runner payouts into the executor:
// a row is 'tracked' until the refund window closes, then the B2 executor transfers
// it (status='paid' + stripeTransferId). See lib/runner-earnings.ts (the display
// decomposition) and process-payout.ts (the executor).
// ============================================================================

model RunnerEarning {
  id      String @id @default(cuid())
  eventId String

  orderId String @unique // one earning per delivered order (idempotent)
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  runnerId String
  runner   Runner @relation(fields: [runnerId], references: [id], onDelete: Cascade)

  amountCents Int // = runnerShare (runner% × applicable fee) + tip, in cents. RECORDED, not paid (payout deferred to Part B).
  // tracked | held | cancelled | paid
  //   tracked   — payable once the window closes (the default accrual state)
  //   held      — C1 admin hold: the executor gate refuses to pay. REVERSIBLE
  //               (release → back to 'tracked'). The reconciler's `status: 'tracked'`
  //               filter already excludes it, but the EXECUTOR is the authoritative
  //               gate — no enqueue path can pay a held row.
  //   cancelled — C1 admin cancel: TERMINAL. Never paid, and never re-picked by any
  //               reconciler sweep (this is what stops a cancelled payout coming back
  //               as an "unpaid straggler" forever).
  //   paid      — the B2 executor transferred it.
  status      String @default("tracked")

  // Part B B2 payout record. The ledger row DOUBLES as the payout record (just as
  // the unpaid row IS the hold) — no separate RunnerPayout table. On a successful
  // transfer the executor sets status='paid' + the transfer id + paidAt. The
  // reconciler asserts status='paid' ⟺ stripeTransferId != null.
  stripeTransferId String?   @unique // the runner payout transfer (idempotency-keyed)
  paidAt           DateTime?

  createdAt DateTime @default(now())

  @@index([runnerId])
  @@index([eventId])
  @@index([status])
}

// ============================================================================
// RUNNER APPLICATION: a platform-level "apply to drive" record from
// /become-driver. NOT a Runner row — Runner is event-scoped (Runner.eventId is
// required, userId @unique), created by an admin when a driver is assigned to a
// specific fair. This is the pending-review application that precedes that, the
// runner analog of how a Vendor application persists with status=PENDING.
// Personal/contact fields live here (the application's contact, may differ from
// the applicant's Clerk identity) — not duplicated onto User. The optional
// userId links the application to the signed-in applicant (POST is auth-optional).
// ============================================================================

model RunnerApplication {
  id String @id @default(cuid())

  // Optional link to the authenticated applicant (the form also works signed-out).
  // SetNull (not Cascade): a reviewable application shouldn't vanish if the half-
  // finished account is deleted.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Personal — the application's contact (kept here, not on User).
  firstName   String
  lastName    String
  email       String
  phone       String
  dateOfBirth DateTime
  city        String?

  // Vehicle.
  vehicleType  String
  vehicleMake  String
  vehicleModel String
  vehicleYear  String
  vehicleColor String?
  vehiclePlate String?

  // Legal consent — an AUDITABLE record, not bare booleans: which affirmations,
  // which terms version, when (server time), and from where (request IP). The
  // applicant's signed identity is the firstName/lastName above. Makes the
  // confirmation screen's "a background check will be initiated" claim real.
  termsAgreed            Boolean
  backgroundCheckConsent Boolean
  termsVersion           String?
  termsAcceptedAt        DateTime
  termsAcceptedIp        String?

  status    RunnerApplicationStatus @default(PENDING)
  createdAt DateTime                @default(now())

  @@index([status])
  @@index([email])
}

enum RunnerApplicationStatus {
  PENDING // Submitted, awaiting review
  APPROVED // Accepted — an admin may now create an event-scoped Runner
  REJECTED // Declined (e.g. failed background check)
}

// Organizer's accrued share of the runner-fulfilled fee: (100 − runnerFeePercent)
// × applicable fee. RECORDED only (status 'accrued') — organizer payout is Part B.
// Mirrors RunnerEarning's shape. NO tip here (tip is 100% the runner's).
model OrganizerEarning {
  id      String @id @default(cuid())
  eventId String

  orderId String @unique // one earning per delivered order (idempotent)
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  organizerId String? // resolved from the event's organizer when available

  amountCents Int // = organizerShare (applicable fee − runnerShare), in cents
  source      String // delivery_fee_share | curbside_fee_share
  // accrued | held | cancelled | paid  (C1 adds held/cancelled — see RunnerEarning.status)
  // planOrganizerPayout's batch set filters `status: 'accrued'`, so a held or
  // cancelled row simply drops OUT of the next batch — the cleanest possible hold.
  status      String @default("accrued")

  // Part B B3 batch audit. N earnings : 1 batch payout (unlike runner's 1:1), so
  // the batch needs its OWN record (OrganizerPayout) — the ledger row can't double
  // as the record here. Each earning FKs to the batch that paid it: answers both
  // "what did this batch pay?" (rows → batch) and "which payout covered this
  // earning?" (batchId). Reconciler asserts: status='paid' ⟺ batchId set ⟺ that
  // batch has a stripeTransferId. The unpaid (batchId null, status accrued) row IS
  // the hold, same as runners.
  paidAt  DateTime?
  batchId String?
  batch   OrganizerPayout? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([eventId])
  @@index([organizerId])
  @@index([status])
  @@index([batchId])
}

// ============================================================================
// ORGANIZER PAYOUT (Part B B3): one batched transfer per event, covering a SET
// of OrganizerEarning rows. The idempotency anchor (idempotencyKey = this id, so
// a re-run finds the existing batch and transfers nothing) AND the audit of which
// payout covered which earnings. NO source_transaction — the batch spans multiple
// charges, so it's a plain transfer from the platform balance. Destination is the
// event's organizer's Connect account (FairOrganizer.stripeAccountId).
// ============================================================================

model OrganizerPayout {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  organizerId String? // the FairOrganizer paid (resolved via the event)

  totalCents       Int // = Σ amountCents of the covered earnings (the proven set sum)
  // pending | held | paid | failed
  //   held — C1 admin hold on an ALREADY-FORMED batch. Distinct from holding the
  //          individual earnings: once a batch exists it is the idempotency anchor,
  //          so the hold must live on the batch too or the executor would re-attempt
  //          it via the crash-recovery "reuse pending batch" path.
  status           String  @default("pending")
  stripeTransferId String? @unique // the batch transfer (idempotency-keyed by this row's id)

  createdAt DateTime  @default(now())
  paidAt    DateTime?

  // The earnings this batch covers (each carries batchId back to here).
  earnings OrganizerEarning[]

  @@index([eventId])
  @@index([status])
}

// ============================================================================
// VENDOR EARNING (C1) — the vendor's accrued, HELD claim on an order.
//
// WHY THIS EXISTS. Runners and organizers each had an earnings ledger; vendors did
// NOT. The vendor's money was always platform-held (separate charges & transfers,
// paid by a delayed job behind the refund window — same as everyone else), but
// between checkout and payout there was NO ROW representing it: `Payout` is written
// AFTER transfers.create, so it's a receipt, not a claim. That left admin with
// nothing to hold. This table is the missing anchor — it makes the vendor path
// structurally identical to the runner path ("the unpaid ledger row IS the hold").
//
// PROVISIONAL AMOUNT, BY DESIGN. subtotalCents is the vendor's claim BEFORE their
// share of the Stripe fee. The real fee is not knowable at accrual time — it's read
// from the settled balance transaction at payout (process-payout.ts refuses to
// guess it, deliberately). So this row NEVER feeds the transfer amount: the executor
// still computes the authoritative net via splitStripeFee at payout time and stamps
// the result back here (feeShareCents/netCents). This ledger is the HOLD ANCHOR and
// the audit record — it is not a second source of truth for the money.
// ============================================================================

model VendorEarning {
  id      String @id @default(cuid())
  eventId String

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  /// The vendor's claim before the Stripe fee share (= Σ their OrderItem subtotals).
  subtotalCents Int

  // accrued | held | cancelled | paid — same vocabulary as RunnerEarning.status.
  status String @default("accrued")

  // Filled by the executor at payout — the AUTHORITATIVE numbers (subtotal − the
  // real settled fee share). Null until paid.
  feeShareCents    Int?
  netCents         Int?
  stripeTransferId String?   @unique
  paidAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, vendorId], map: "uq_vendorearning_order_vendor")
  @@index([eventId])
  @@index([vendorId, status])
  @@index([status])
}

// ============================================================================
// ADMIN MONEY ACTION (C1) — the durable audit trail for every admin money action.
//
// WHY A NEW TABLE. Neither existing audit surface can carry this:
//   - the admin chokepoint's audit (admin-fair-context.ts) is a logger.info line —
//     ephemeral stdout, not a record you can produce months later in a dispute.
//   - VendorAuditLog REQUIRES a vendorId, so it structurally cannot log an action
//     against a runner or an organizer.
// Money actions get contested ("you took my money"). This row IS the defense: who,
// what, whose money, which fair, how much, when, and why. Append-only by convention —
// a release does not mutate the hold row, it appends a RELEASE row.
// ============================================================================

model AdminMoneyAction {
  id String @id @default(cuid())

  /// WHO actually acted. Not admin-only: a money action can be taken by an admin (Clerk id),
  /// an organizer (their user id, e.g. an organizer refund), the reconciler, or the system
  /// (webhook-driven). The audit must record who truly acted — routing a non-admin action
  /// through an "adminClerkId" field would be attribution that lies. Paired with actorType.
  actorId String

  /// admin | organizer | system | reconciler — the actor's role. Grandfathered: every row that
  /// existed before this field was added was an admin action, so the default is 'admin'.
  actorType String @default("admin")

  /// HOLD | RELEASE | CANCEL | FREEZE | UNFREEZE
  action String

  /// vendor | runner | organizer
  payeeType String
  payeeId   String

  /// Always set — every admin money action is scoped to ONE fair by the chokepoint.
  eventId String

  /// Set for per-order actions (HOLD/RELEASE/CANCEL); null for entity FREEZE/UNFREEZE.
  orderId String?

  /// The ledger row acted on, when there is one.
  earningId String?

  /// What was at stake, in cents, at the moment of the action (informational).
  amountCents Int?

  /// The admin's stated justification. Required by the API — never optional in practice.
  reason String

  /// Free-form context (before/after status, batch id, …). Stored, never queried by content.
  metadata Json?

  createdAt DateTime @default(now())

  @@index([eventId, createdAt])
  @@index([payeeType, payeeId])
  @@index([actorId])
  @@index([actorType])
  @@index([action])
}

enum RunnerStatus {
  OFFLINE // Not active / off shift
  ACTIVE // Checked in and available for dispatch
  ON_DELIVERY // Currently fulfilling an order
}

// Generic, shared approval lifecycle. Named generically (NOT RunnerApprovalStatus)
// because organizer approval (#7) reuses this exact enum + audit-field shape.
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// ============================================================================
// INCIDENT REPORTS
// Filed by Runner when an order is dropped, damaged, or lost.
// Operator has 5 minutes to respond before auto-refund triggers.
// ============================================================================

model IncidentReport {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  runnerId String
  runner   Runner @relation(fields: [runnerId], references: [id])

  type          IncidentType
  affectedItems Json? // array of orderItemIds; null = entire order
  notes         String?
  photoUrl      String?

  reportedAt          DateTime  @default(now())
  resolvedAt          DateTime?
  resolution          String? // full_refund | partial_refund | replacement | none
  autoRefundTriggered Boolean   @default(false)

  @@index([orderId])
  @@index([runnerId])
}

enum IncidentType {
  DROPPED
  DAMAGED
  LOST
  MISSING_ITEMS
}

// ============================================================================
// DISPUTES
// Vendor-initiated. 7-day submission window. 24-hour admin SLA before escalation.
// ============================================================================

model Dispute {
  id       String @id @default(cuid())
  orderId  String
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  reason   String
  evidence Json?

  status      DisputeStatus @default(OPEN)
  submittedAt DateTime      @default(now())
  resolvedAt  DateTime?
  resolution  String?

  @@index([vendorId])
  @@index([status])
}

enum DisputeStatus {
  OPEN // Filed, awaiting admin action
  RESOLVED // Admin has resolved
  ESCALATED // 24-hour SLA elapsed without action
}

// ============================================================================
// ORDER EVENT AUDIT LOG
// Written on every status transition. Required for dispute cross-referencing
// and the post-event reconciliation engine.
// ============================================================================

model OrderEvent {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  eventType String // placed | accepted | preparing | ready | runner_collected | completed | delivered | cancelled | uncollected | undeliverable
  actorId   String? // userId of who triggered this transition
  actorRole String? // customer | vendor | runner | system
  metadata  Json? // e.g., { reason: "...", refundAmount: 5.00 }

  timestamp DateTime @default(now())

  @@index([orderId])
  @@index([timestamp])
}

// Why an order is stranded — named for the ACTION a human must take, because the
// escalation surface's whole job is telling someone what to do. A closed set (each maps to
// one distinct human response), so it's an enum: an unrecognized value FAILS LOUD, matching
// this neighborhood's derivation stance (VENDOR_PROGRESS throws rather than rank 0).
enum StrandedReason {
  CLAIMED_NOT_COLLECTED // pre-collection stall: food is safe on the counter — find or release the runner
  RUNNER_UNREACHABLE_WITH_FOOD // post-collection: the runner has the bag and is unreachable — go find the runner
  AWAITING_VENDOR_CONFIRMATION // return requested, vendor hasn't confirmed — go tap the vendor
}

// The custody audit spine for the possession-split escape path (Commit 2). One row per
// custody transition (collect / release / return_requested / return_confirmed / stranded /
// strand_cleared). Denormalizes runnerId so the trail SURVIVES a release nulling Order.runnerId
// — the record of who held the bag must outlive the live assignment. Mirrors OrderEvent.
model DeliveryCustodyEvent {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  eventType String // collected | released | return_requested | return_confirmed | stranded | strand_cleared
  actorId   String? // who acted (runner/vendor/organizer/admin userId, or null for system/reconciler)
  actorRole String? // runner | vendor | organizer | admin | system
  runnerId  String? // the runner in custody at the time (denormalized; survives Order.runnerId being nulled on release)
  metadata  Json? // e.g. { strandedReason, fromStatus, releasedTo: "pool", clearedBy }

  timestamp DateTime @default(now())

  @@index([orderId])
  @@index([timestamp])
  @@index([eventType])
}

// ============================================================================
// POST-EVENT REPORT
// Auto-generated within 48 hours of Close Event.
// ============================================================================

model PostEventReport {
  id      String @id @default(cuid())
  eventId String @unique
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  generatedAt DateTime  @default(now())
  emailedAt   DateTime?

  // Core metrics
  totalOrders  Int
  totalRevenue Float

  // Breakdown fields (JSON for flexibility)
  revenueByType     Json // { BOOTH_PICKUP: x, CURBSIDE: y, HOME_DELIVERY: z }
  vendorBreakdown   Json // [{ vendorId, name, revenue, orderCount, avgFulfillmentMins, cancellationRate }]
  peakWindows       Json // [{ windowStart, windowEnd, orderCount }] — 30-min buckets
  runnerPerformance Json // [{ runnerId, name, delivered, collected, rate, incidents }] — from lib/runner-completion (custody events), NOT the deprecated Runner counter columns; nothing writes this field yet
  cancellationLog   Json // [{ orderId, reason, cancelledBy, refundIssued, refundAmount }]
  platformIssues    Json? // any outages, heartbeat drops, Stripe errors

  recommendations String? // plain text, written by system or FairSynq staff
  pdfUrl          String? // Supabase Storage URL after PDF generation

  @@index([eventId])
}

// ============================================================================
// FAVORITE ITEMS
// Customer-saved menu items. Per-user, per-item unique.
// ============================================================================

model FavoriteItem {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, menuItemId])
  @@index([userId])
}

// ============================================================================
// WEBHOOK IDEMPOTENCY
// Prevents duplicate processing when Stripe retries a webhook event.
// ============================================================================

model ProcessedWebhookEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  processedAt   DateTime @default(now())

  @@index([processedAt])
}

// ============================================================================
// VENDOR AUDIT LOG
// Immutable record of vendor-initiated actions for organizer/admin review.
// ============================================================================

model VendorAuditLog {
  id       String @id @default(cuid())
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Action type — coarse-grained bucket for filtering
  // e.g., ORDER_ACCEPTED | ORDER_DECLINED | MENU_CHANGE_REQUESTED | SETTINGS_UPDATED
  action String

  // Free-form structured data: orderId, menuItemId, before/after values, etc.
  // Stored as JSON — never queried by content, only returned as-is.
  metadata Json?

  createdAt DateTime @default(now())

  @@index([vendorId, createdAt])
  @@index([userId])
}

// ============================================================================
// RUNNER PROFILE CHANGE LOG — append-only audit of edits to a runner's mutable
// profile fields (phone + vehicle), old → new with a timestamp. Answers "what did
// their profile say at time T" for dispute/incident review, complementing the
// per-order vehicle SNAPSHOT (Order.runnerVehicle*, the direct answer for a given
// delivery). PII-BEARING (phone numbers, old values): rows are PURGED 180 days
// after the runner's event ends by reconciler Pattern W (a real deleter, not a
// promise). License documents are versioned separately by the replace-upload flow.
// PII exposure/retention decisions recorded in docs/PII_DECISIONS.md.
// ============================================================================
model RunnerProfileChange {
  id       String @id @default(cuid())
  runnerId String
  runner   Runner @relation(fields: [runnerId], references: [id], onDelete: Cascade)

  field    String // 'phone' | 'vehicleMake' | 'vehicleModel' | 'vehicleColor' | 'vehiclePlate'
  oldValue String?
  newValue String?

  changedAt DateTime @default(now())

  @@index([runnerId, changedAt])
  @@index([changedAt]) // Pattern W retention sweep scans by age
}

// ============================================================================
// SWEEP RUN — the reconciler's durable history. One row per COMPLETED sweep.
//
// WHY THIS EXISTS. Until 2026-07-29 there was no durable record of sweep results at all:
// `sum.repaired` went to logs with finite retention, and the Redis heartbeat holds one
// timestamp overwritten every 60s. The consequence, measured: the ONLY durable proof any
// pattern had ever repaired anything was 148 AdminMoneyAction rows from Pattern T, all inside
// a 4-minute window on 2026-07-19 — and those came from a supervised one-off, not the routine
// sweep catching a live leak. Twenty-two patterns were indistinguishable from dead code, and
// no amount of reading the source resolved it. A quiet backstop and a broken one look the same
// from outside; this table is what tells them apart.
//
// PER-PATTERN COUNTS AS JSON, NOT A CHILD TABLE — decided, not defaulted:
//   • the map is always read WITH its parent (nobody wants a pattern count without the run),
//     so the join a child table buys is a join nobody needs;
//   • a child table costs ~21 rows per sweep = ~30k/day = ~11M/year, versus 1,440/day here;
//   • the questions this must answer are still one query in JSONB —
//       SELECT key, sum(value::int) FROM "SweepRun", jsonb_each_text(repaired) GROUP BY key;
//   • the FULL map is stored (zeros included), not just non-zero entries, so a row also records
//     WHICH PATTERNS EXISTED at that commit — which is how a pattern being added or removed
//     stays visible in history rather than silently changing the denominator.
//
// WRITTEN AT THE END, next to the heartbeat: a row therefore means the sweep COMPLETED. A row
// written at the start would claim runs that crashed midway. Best-effort — recordSweepRun
// swallows its own errors, because losing the record of a sweep must never fail the sweep.
//
// DRY RUNS ARE RECORDED AND FLAGGED, never skipped: a dry run that WOULD have repaired
// something is exactly the signal worth keeping.
//
// RETENTION: ~1,440 rows/day, ~525k/year, ~200B of JSON each (~105MB/yr) — comfortable for
// years. NO automatic pruning is built (deleting history is how you lose the answer this table
// exists to give). If it is ever wanted, the honest policy is downsampling, not deletion:
// keep every row for 90 days, then one row per hour. Pattern W is the precedent for a real
// deleter, deliberately NOT reused here.
// ============================================================================
model SweepRun {
  id String @id @default(cuid())

  startedAt  DateTime
  finishedAt DateTime
  durationMs Int

  /// true ⇒ `repaired` counts what the sweep WOULD have done, not what it did.
  dryRun Boolean

  /// Worker build that produced this run (health.WORKER_COMMIT). Null/'unknown' when the
  /// deploy did not expose a SHA — recorded honestly rather than defaulted to a lie.
  commit String?

  /// Per-pattern repaired counts, e.g. {"A":0,"B":0,...,"X":2}. The whole point: a global
  /// repairedTotal=2 does not say which backstop earned its 60 seconds.
  repaired Json

  repairedTotal    Int
  alertedCount     Int
  suppressedCount  Int
  ambiguousSkipped Int

  createdAt DateTime @default(now())

  @@index([startedAt])
  @@index([dryRun, startedAt]) // "real runs, most recent first" is the common read
}
